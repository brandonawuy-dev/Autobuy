--// HELPERS
local function Norm(Value)
    local Text = tostring(Value or "")
    Text = Text:gsub("^%s+", "")
    Text = Text:gsub("%s+$", "")
    return string.lower(Text)
end

local function ParseList(Text)
    local Set = {}
    for Piece in string.gmatch(tostring(Text or ""), "[^,]+") do
        local Key = Norm(Piece)
        if Key ~= "" then
            Set[Key] = true
        end
    end
    return Set
end

local function Dump(Value, Depth)
    Depth = Depth or 0
    if typeof(Value) ~= "table" or Depth > 3 then
        return tostring(Value)
    end
    local Parts = {}
    for Key, Val in pairs(Value) do
        table.insert(Parts, tostring(Key) .. "=" .. Dump(Val, Depth + 1))
    end
    return "{" .. table.concat(Parts, ", ") .. "}"
end

--// SETTINGS
local TargetNames = ParseList("Goju")        -- multiple names allowed, comma separated
local TargetRarities = ParseList("Secret")   -- empty = any rarity

local AutoRoll = false
local AutoFirePrompt = true
local DebugMode = false

local RollDelay = 1
local PromptDelay = 0.2        -- wait after teleport, before activating prompt
local MaxPromptAttempts = 5    -- retries if UnitBought doesn't arrive
local RetryInterval = 1        -- seconds between prompt attempts

local MutationList = {
    "Normal", "Raijin", "Honored", "Apostle", "Cursed", "Hollow", "Godspeed"
}

local MutationSettings = {
    Normal = true,   -- ON for testing. Turn OFF for real use.
    Raijin = true,
    Honored = true,
    Apostle = true,
    Cursed = true,
    Hollow = true,
    Godspeed = true
}

--// STATE
local SavedPositions = {
    [1] = nil,
    [2] = nil,
    [3] = nil
}

local Busy = false          -- true = rolling paused while handling targets
local PendingTarget = nil   -- target currently waiting for purchase
local Session = 0           -- bumped on cancel to stop a running queue

--// CHARACTER
local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

--// NOTIFICATION
local function Notify(Title, Content)
    Rayfield:Notify({
        Title = Title,
        Content = Content,
        Duration = 4
    })
end

--// POSITION
local function SavePosition(Index)
    local Root = GetRoot()

    if not Root then
        Notify("Position", "Character not found.")
        return
    end

    SavedPositions[Index] = Root.CFrame
    Notify("Position Saved", "Summoner position " .. Index .. " saved.")
end

local function TeleportToPosition(Index)
    local Root = GetRoot()
    local Position = SavedPositions[Index]

    if not Root then
        Notify("Teleport", "Character not found.")
        return false
    end

    if not Position then
        Notify("Teleport", "Position " .. Index .. " has not been saved.")
        return false
    end

    Root.CFrame = Position
    return true
end

--// PROMPT POSITION
local function GetPromptPosition(Prompt)
    local Parent = Prompt.Parent

    if not Parent then
        return nil
    end

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    if Parent:IsA("BasePart") then
        return Parent.Position
    end

    if Parent:IsA("Model") and Parent.PrimaryPart then
        return Parent.PrimaryPart.Position
    end

    return nil
end

--// FIND NEAREST ENABLED PROMPT
local function FindNearestPrompt()
    local Root = GetRoot()

    if not Root then
        return nil
    end

    local NearestPrompt = nil
    local NearestDistance = math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("ProximityPrompt") and Object.Enabled then
            local Position = GetPromptPosition(Object)

            if Position then
                local Distance = (Root.Position - Position).Magnitude

                if Distance <= Object.MaxActivationDistance
                    and Distance < NearestDistance then

                    NearestDistance = Distance
                    NearestPrompt = Object
                end
            end
        end
    end

    return NearestPrompt, NearestDistance
end

--// FIRE A PROMPT
local function FirePrompt(Prompt)
    if fireproximityprompt then
        fireproximityprompt(Prompt)
    else
        Prompt:InputHoldBegin()
        task.wait(math.max(Prompt.HoldDuration, 0.05))
        Prompt:InputHoldEnd()
    end
end

--// ACTIVATE NEAREST PROMPT
local function ActivateNearestPrompt()
    local Prompt, Distance = FindNearestPrompt()

    if not Prompt then
        Notify("Prompt", "No enabled prompt within activation range.")
        return false
    end

    if DebugMode then
        print("[Goju Debug] Prompt:", Prompt:GetFullName(), math.floor(Distance))
    end

    local Success, ErrorMessage = pcall(function()
        FirePrompt(Prompt)
    end)

    if not Success then
        Notify("Prompt Error", tostring(ErrorMessage))
        return false
    end

    return true
end

--// MATCH CHECKS
local function IsMutationAllowed(Mutation)
    return MutationSettings[Mutation] == true
end

local function IsTarget(Name, Rarity, Mutation)
    if not TargetNames[Norm(Name)] then
        return false
    end

    if next(TargetRarities) ~= nil and not TargetRarities[Norm(Rarity)] then
        return false
    end

    return IsMutationAllowed(Mutation)
end

--// HANDLE ONE TARGET (teleport -> wait -> prompt -> wait for UnitBought)
local function HandleTarget(Target, MySession)
    TeleportToPosition(Target.Index)

    task.wait(PromptDelay)

    if not AutoFirePrompt then
        Notify("Waiting", "Auto Fire is off. Activate the prompt manually.")

        while not Target.Done and Session == MySession do
            task.wait(0.1)
        end

        return
    end

    local Attempts = 0

    while not Target.Done
        and Session == MySession
        and Attempts < MaxPromptAttempts do

        Attempts = Attempts + 1

        ActivateNearestPrompt()

        local Started = os.clock()

        while not Target.Done
            and Session == MySession
            and os.clock() - Started < RetryInterval do

            task.wait(0.1)
        end
    end

    if not Target.Done and Session == MySession then
        Notify("Timeout", Target.Name .. " purchase was not confirmed.")
    end
end

--// PROCESS ALL TARGETS FROM ONE ROLL, THEN RESUME
local function ProcessQueue(Queue, MySession)
    for _, Target in ipairs(Queue) do
        if Session ~= MySession then
            return
        end

        PendingTarget = Target
        HandleTarget(Target, MySession)
    end

    if Session == MySession then
        PendingTarget = nil
        Busy = false

        if AutoRoll then
            Notify("Auto Roll", "Resuming roll sequence.")
        end
    end
end

--// ROLL RESULT HANDLER
local function ProcessRollResults(Results)
    if DebugMode then
        print("[Goju Debug] RollResult:", Dump(Results))
    end

    if Busy then
        return
    end

    if typeof(Results) ~= "table" then
        return
    end

    if Results.Name ~= nil then
        Results = { Results }
    end

    local Queue = {}

    for _, Item in ipairs(Results) do
        if typeof(Item) == "table" then
            local Name = Item.Name
            local Rarity = Item.Rarity
            local Mutation = Item.Mutation
            local Index = tonumber(Item.Index)

            if Mutation == nil or Mutation == "" then
                Mutation = "Normal"
            end

            if IsTarget(Name, Rarity, Mutation) then
                if not Index or not SavedPositions[Index] then
                    Notify(
                        "Target Skipped",
                        tostring(Name) .. " | " .. tostring(Mutation) ..
                        "\nNo saved position for index " .. tostring(Index)
                    )
                else
                    table.insert(Queue, {
                        Name = Name,
                        Mutation = Mutation,
                        Index = Index,
                        Done = false
                    })
                end
            end
        end
    end

    if #Queue == 0 then
        return -- no match: rolling continues
    end

    Busy = true
    Session = Session + 1

    local Found = {}
    for _, Target in ipairs(Queue) do
        table.insert(Found, Target.Name .. " (" .. Target.Mutation .. ", #" .. Target.Index .. ")")
    end

    Notify("TARGET FOUND", table.concat(Found, "\n"))

    task.spawn(ProcessQueue, Queue, Session)
end

--// ROLL RESULT CONNECTION
RollResultRemote.OnClientEvent:Connect(function(Results, ...)
    ProcessRollResults(Results)
end)

--// PURCHASE CONFIRMATION
UnitBoughtRemote.OnClientEvent:Connect(function(Name, Mutation, ...)
    if not Busy or not PendingTarget or PendingTarget.Done then
        return
    end

    if Name == PendingTarget.Name
        and (Mutation or "Normal") == PendingTarget.Mutation then

        PendingTarget.Done = true
        Notify("Purchase Confirmed", Name .. " | " .. tostring(Mutation))
    end
end)

--// AUTO ROLL LOOP
task.spawn(function()
    while task.wait(0.05) do
        if AutoRoll and not Busy then
            local Success, ErrorMessage = pcall(function()
                RollRemote:FireServer()
            end)

            if not Success then
                warn("[Goju Automation] Roll error:", ErrorMessage)
            end

            task.wait(RollDelay)
        end
    end
end)

